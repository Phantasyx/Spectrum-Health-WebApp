{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "first-look",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "firstlook.phantasyx.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
